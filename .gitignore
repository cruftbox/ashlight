# WiFi credentials. Never commit.
secrets.yaml

# ESPHome build output
.esphome/
*.bin
*.elf

# Local toolchain. PlatformIO refuses Python 3.14, so the build runs from a
# Python 3.13 venv rather than the system interpreter.
.venv/

# Captured PurpleAir payloads contain precise lat/lon.
# Scrub before committing any sample data.
*payload*.json
