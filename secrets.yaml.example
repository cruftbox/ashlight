# Copy to secrets.yaml in the ESPHome add-on config directory on Wintermute.
# secrets.yaml itself is gitignored and must never be committed.

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# 32 bytes, base64. Generate with:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "generate-me"

ota_password: "pick-something"
fallback_ap_password: "pick-something-else"
